{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.actools.invalid/common-1.0.0.schema.json",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]{1,62}(?![\\s\\S])"
    },
    "contractIdentifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9.-]{1,94}[a-z0-9](?![\\s\\S])"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "ownedReference": {
      "type": "string",
      "minLength": 3,
      "maxLength": 192,
      "pattern": "^[a-z][a-z0-9-]*://[A-Za-z0-9][A-Za-z0-9._:/-]{1,188}(?![\\s\\S])"
    },
    "domain": {
      "type": "string",
      "maxLength": 253,
      "format": "actools-domain"
    },
    "endpoint": {
      "type": "string",
      "maxLength": 320,
      "format": "actools-endpoint"
    },
    "filesystemAuthorityId": {
      "type": "string",
      "maxLength": 71,
      "format": "actools-filesystem-authority-id"
    },
    "secretReference": {
      "type": "string",
      "maxLength": 160,
      "format": "actools-secret-reference"
    },
    "policyReference": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^policy://[a-z][a-z0-9-]{0,62}/[A-Za-z0-9._-]{1,64}(?![\\s\\S])"
    },
    "releaseReference": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^release://[a-z][a-z0-9-]{0,62}/[A-Za-z0-9._-]{1,64}(?![\\s\\S])"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation_id", "site_id", "environment_id"],
      "properties": {
        "installation_id": {"type": "string", "minLength": 2, "maxLength": 63, "pattern": "^[a-z][a-z0-9-]{1,62}(?![\\s\\S])"},
        "site_id": {"type": "string", "minLength": 2, "maxLength": 63, "pattern": "^[a-z][a-z0-9-]{1,62}(?![\\s\\S])"},
        "environment_id": {"type": "string", "minLength": 2, "maxLength": 63, "pattern": "^[a-z][a-z0-9-]{1,62}(?![\\s\\S])"}
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "media_type", "digest", "source"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 3, "maxLength": 96, "pattern": "^[a-z][a-z0-9.-]{1,94}[a-z0-9](?![\\s\\S])"},
        "media_type": {
          "enum": [
            "application/json",
            "application/zip",
            "text/html",
            "text/markdown",
            "text/plain"
          ]
        },
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "source": {"type": "string", "minLength": 3, "maxLength": 192, "pattern": "^[a-z][a-z0-9-]*://[A-Za-z0-9][A-Za-z0-9._:/-]{1,188}(?![\\s\\S])"}
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "digest", "source", "trust"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 3, "maxLength": 96, "pattern": "^[a-z][a-z0-9.-]{1,94}[a-z0-9](?![\\s\\S])"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "source": {"type": "string", "minLength": 3, "maxLength": 192, "pattern": "^[a-z][a-z0-9-]*://[A-Za-z0-9][A-Za-z0-9._:/-]{1,188}(?![\\s\\S])"},
        "trust": {"enum": ["authenticated", "self-asserted", "unverified"]}
      }
    }
  }
}
