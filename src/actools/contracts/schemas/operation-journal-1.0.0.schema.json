{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.actools.invalid/operation-journal-1.0.0.schema.json",
  "title": "Actools protected operation journal record 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journal_id",
    "operation_id",
    "plan_id",
    "plan_digest",
    "state",
    "actor",
    "protected_target_ids",
    "locks",
    "predecessor_generation",
    "target_generation",
    "intent_at",
    "attempts",
    "deadlines",
    "handler",
    "expected_postconditions",
    "evidence_refs",
    "error",
    "reconciliation",
    "cleanup_obligations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "journal_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
    "operation_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
    "plan_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
    "plan_digest": {"$ref": "common-1.0.0.schema.json#/$defs/sha256"},
    "state": {"enum": ["pending", "running", "succeeded", "failed", "blocked", "interrupted"]},
    "actor": {"$ref": "#/$defs/authenticatedActor"},
    "protected_target_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "common-1.0.0.schema.json#/$defs/ownedReference"}
    },
    "locks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/resourceLock"}
    },
    "predecessor_generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "target_generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "intent_at": {"$ref": "common-1.0.0.schema.json#/$defs/utcTimestamp"},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/attempt"}
    },
    "deadlines": {"$ref": "#/$defs/deadlines"},
    "handler": {"$ref": "#/$defs/handler"},
    "expected_postconditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/postcondition"}
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "common-1.0.0.schema.json#/$defs/evidenceReference"}
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/journalError"}
      ]
    },
    "reconciliation": {"$ref": "#/$defs/reconciliation"},
    "cleanup_obligations": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/cleanupObligation"}
    }
  },
  "$defs": {
    "authenticatedActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "authentication_method", "authentication_reference"],
      "properties": {
        "subject_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "authentication_method": {"enum": ["local-peer", "ssh-certificate", "mfa-session", "scheduled-policy"]},
        "authentication_reference": {"$ref": "common-1.0.0.schema.json#/$defs/ownedReference"}
      }
    },
    "resourceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock_id", "resource_id", "owner_operation_id", "acquired_at"],
      "properties": {
        "lock_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "resource_id": {"$ref": "common-1.0.0.schema.json#/$defs/ownedReference"},
        "owner_operation_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "acquired_at": {"$ref": "common-1.0.0.schema.json#/$defs/utcTimestamp"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "effect_id", "state", "started_at", "finished_at", "deadline_at"],
      "properties": {
        "attempt_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "effect_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "state": {"enum": ["pending", "running", "succeeded", "failed", "blocked", "interrupted"]},
        "started_at": {"$ref": "common-1.0.0.schema.json#/$defs/utcTimestamp"},
        "finished_at": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "common-1.0.0.schema.json#/$defs/utcTimestamp"}
          ]
        },
        "deadline_at": {"$ref": "common-1.0.0.schema.json#/$defs/utcTimestamp"}
      }
    },
    "deadlines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_deadline_at", "lock_deadline_at", "safety_deadline_at"],
      "properties": {
        "operation_deadline_at": {"$ref": "common-1.0.0.schema.json#/$defs/utcTimestamp"},
        "lock_deadline_at": {"$ref": "common-1.0.0.schema.json#/$defs/utcTimestamp"},
        "safety_deadline_at": {"$ref": "common-1.0.0.schema.json#/$defs/utcTimestamp"}
      }
    },
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handler_id", "version", "release_digest"],
      "properties": {
        "handler_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "version": {"$ref": "common-1.0.0.schema.json#/$defs/schemaVersion"},
        "release_digest": {"$ref": "common-1.0.0.schema.json#/$defs/sha256"}
      }
    },
    "postcondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "required", "state", "evidence_id"],
      "properties": {
        "check_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "required": {"type": "boolean"},
        "state": {"enum": ["pending", "satisfied", "failed", "unknown"]},
        "evidence_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"}
          ]
        }
      }
    },
    "journalError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_id", "source", "message_id", "evidence_id"],
      "properties": {
        "error_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "source": {"enum": ["handler", "engine", "authorization", "verification", "delivery"]},
        "message_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "evidence_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"}
          ]
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "required", "reason_id"],
      "properties": {
        "classification": {"enum": ["not-needed", "safe-retry", "inspect-required", "recovery-required", "manual-decision"]},
        "required": {"type": "boolean"},
        "reason_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"}
      }
    },
    "cleanupObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanup_id", "resource_id", "state", "deadline_at"],
      "properties": {
        "cleanup_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "resource_id": {"$ref": "common-1.0.0.schema.json#/$defs/ownedReference"},
        "state": {"enum": ["not-required", "pending", "succeeded", "failed", "unknown"]},
        "deadline_at": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "common-1.0.0.schema.json#/$defs/utcTimestamp"}
          ]
        }
      }
    }
  }
}
