{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.actools.invalid/release-manifest-1.0.0.schema.json",
  "title": "Actools release manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "release_version",
    "source_commit",
    "artifacts",
    "dependencies",
    "license_references",
    "sbom_references",
    "platform_profiles",
    "contract_compatibility",
    "schema_update_edges",
    "recovery_edges",
    "upgrade_edges",
    "requirement_graph_digest",
    "configuration_template_digest",
    "security_floor",
    "verification",
    "qualification_receipts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
    "release_version": {"$ref": "common-1.0.0.schema.json#/$defs/schemaVersion"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/releaseArtifact"}
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/dependency"}
    },
    "license_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "common-1.0.0.schema.json#/$defs/ownedReference"}
    },
    "sbom_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "common-1.0.0.schema.json#/$defs/ownedReference"}
    },
    "platform_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/platformProfile"}
    },
    "contract_compatibility": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/contractCompatibility"}
    },
    "schema_update_edges": {"$ref": "#/$defs/versionEdges"},
    "recovery_edges": {"$ref": "#/$defs/versionEdges"},
    "upgrade_edges": {"$ref": "#/$defs/versionEdges"},
    "requirement_graph_digest": {"$ref": "common-1.0.0.schema.json#/$defs/sha256"},
    "configuration_template_digest": {"$ref": "common-1.0.0.schema.json#/$defs/sha256"},
    "security_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "digest"],
      "properties": {
        "policy_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "policy_version": {"$ref": "common-1.0.0.schema.json#/$defs/schemaVersion"},
        "digest": {"$ref": "common-1.0.0.schema.json#/$defs/sha256"}
      }
    },
    "verification": {"$ref": "#/$defs/verification"},
    "qualification_receipts": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/qualificationReceipt"}
    }
  },
  "$defs": {
    "releaseArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "digest", "source"],
      "properties": {
        "artifact_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "kind": {"enum": ["management", "application-image", "database-image", "proxy-image", "template", "policy"]},
        "digest": {"$ref": "common-1.0.0.schema.json#/$defs/sha256"},
        "source": {"$ref": "common-1.0.0.schema.json#/$defs/ownedReference"}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest", "license_id"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}(?![\\s\\S])"},
        "version": {"type": "string", "minLength": 1, "maxLength": 96},
        "digest": {"$ref": "common-1.0.0.schema.json#/$defs/sha256"},
        "license_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}(?![\\s\\S])"}
      }
    },
    "platformProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "os", "architecture", "runtime_backend", "advertised"],
      "properties": {
        "profile": {"const": "single-site-production"},
        "os": {"const": "ubuntu-26.04"},
        "architecture": {"const": "amd64"},
        "runtime_backend": {"const": "docker-compose"},
        "advertised": {"type": "boolean"}
      }
    },
    "contractCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "reader_versions", "writer_version"],
      "properties": {
        "family": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}(?![\\s\\S])"},
        "reader_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "common-1.0.0.schema.json#/$defs/schemaVersion"}
        },
        "writer_version": {"$ref": "common-1.0.0.schema.json#/$defs/schemaVersion"}
      }
    },
    "versionEdges": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/versionEdge"}
    },
    "versionEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_version", "to_version", "edge_id", "classification"],
      "properties": {
        "from_version": {"$ref": "common-1.0.0.schema.json#/$defs/schemaVersion"},
        "to_version": {"$ref": "common-1.0.0.schema.json#/$defs/schemaVersion"},
        "edge_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "classification": {"enum": ["compatible", "migration-required", "recovery-only", "unsupported"]}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature_scheme", "signature_reference", "trust_root_reference", "verified_at"],
      "properties": {
        "signature_scheme": {"enum": ["minisign", "sigstore", "openpgp"]},
        "signature_reference": {"$ref": "common-1.0.0.schema.json#/$defs/ownedReference"},
        "trust_root_reference": {"$ref": "common-1.0.0.schema.json#/$defs/ownedReference"},
        "verified_at": {"$ref": "common-1.0.0.schema.json#/$defs/utcTimestamp"}
      }
    },
    "qualificationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "gate_id", "target", "result", "digest"],
      "properties": {
        "receipt_id": {"$ref": "common-1.0.0.schema.json#/$defs/contractIdentifier"},
        "gate_id": {"type": "string", "pattern": "^G(?:0[1-9]|1[0-9]|2[0-2])(?![\\s\\S])"},
        "target": {"$ref": "common-1.0.0.schema.json#/$defs/ownedReference"},
        "result": {"enum": ["pass", "fail", "not-run"]},
        "digest": {"$ref": "common-1.0.0.schema.json#/$defs/sha256"}
      }
    }
  }
}
